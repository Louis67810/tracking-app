# Frontend public configuration (same Supabase project as the server)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FOCUS_ALLOWED_EMAILS=
FOCUS_TIMEZONE=Europe/Paris

# Choose a current Anthropic model from https://ai-gateway.vercel.sh/v1/models
# Verified during implementation: anthropic/claude-sonnet-5.5
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
# Optional on Vercel with OIDC. Required for local API testing.
AI_GATEWAY_API_KEY=
